# ---------------------------------------------------------------------------
# TickTrack UK API - environment
#
#   cp .env.example .env     then edit .env
#
# .env is gitignored. Never commit a real connection string.
# ---------------------------------------------------------------------------

# -- Database (REQUIRED) ----------------------------------------------------
# Any PostgreSQL 14+ will do. Two common options:
#
# 1) Supabase (what this project targets).
#    Supabase dashboard -> Connect -> "Connection string" -> URI.
#    Prefer the SESSION POOLER string (port 5432) or the TRANSACTION POOLER
#    (port 6543); the direct db.<ref>.supabase.co host is IPv6-only on the
#    free tier and will fail to resolve on most home networks.
#    Replace [YOUR-PASSWORD] with your database password.
#
#    DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 2) A local cluster, e.g. `brew install postgresql@16 && createdb ticktrack`:
#
#    DATABASE_URL=postgresql://localhost:5432/ticktrack
#
DATABASE_URL=postgresql://localhost:5432/ticktrack

# TLS. Auto-detected from the host: off for localhost, on for anything else.
# Set explicitly only to override that.
# DATABASE_SSL=true

# -- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Browser origins permitted to call this API. Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- Upstream Elanco API ----------------------------------------------------
# Public, read-only, no key required.
ELANCO_API_BASE_URL=https://dev-task.elancoapps.com/data
ELANCO_TIMEOUT_MS=20000

# -- Behaviour --------------------------------------------------------------
# Run an ingest on boot when the sightings table is empty. Handy for a fresh
# clone; in production ingest should be a scheduled job instead.
INGEST_ON_BOOT=true

# Largest JSON body accepted. Must clear a base64 photograph with headroom.
MAX_BODY_SIZE=8mb

# Largest page the sightings endpoint will return.
MAX_PAGE_SIZE=5000
