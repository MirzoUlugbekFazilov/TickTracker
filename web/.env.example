# ---------------------------------------------------------------------------
# TickTrack UK frontend - environment
#
# All optional in local development: the Vite dev server proxies /api to
# http://localhost:4000, so no configuration is needed to run locally.
#
# Only VITE_ variables are exposed to the browser. Never put a secret here -
# everything in this file ends up readable in the shipped bundle.
# ---------------------------------------------------------------------------

# Base URL of the TickTrack API.
# Leave unset locally (defaults to the relative "/api", which Vite proxies).
# REQUIRED on Vercel, where the frontend and API are on different origins:
#   VITE_API_BASE_URL=https://your-api-host.example.com/api
# VITE_API_BASE_URL=

# Map tiles. Defaults to the OpenStreetMap standard raster layer.
# If you change the URL you MUST change the attribution to match that
# provider's terms - it is a licence requirement, not a formality.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Maximum photograph upload size in megabytes. Defaults to 5.
# Client-side check only; the API enforces its own body limit.
# VITE_MAX_IMAGE_SIZE_MB=5
